# STEP files are plain text under the hood but are CAD-generated 3D
# models — treating them as binary keeps git from trying to show
# line-by-line diffs of multi-MB files.
*.step -diff binary
*.kicad_pcb -diff
*.kicad_sch -diff

# If the repo starts getting heavy because of the 29MB STEP file, it can
# be migrated to Git LFS by uncommenting these lines (requires running
# "git lfs install" first):
# *.step filter=lfs diff=lfs merge=lfs -text
